{
  "name": "keel-skill",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A self-updating console for software projects: rules, a component registry, API docs and a wiki generated from repo sources, plus a visibility-boundary model (artifact / identity / field) and a pre-release security gate.",
  "keywords": [
    "agent-skill",
    "ai-agents",
    "claude-code",
    "cursor",
    "codex",
    "trae",
    "workbuddy",
    "developer-tools",
    "documentation",
    "docs-as-code",
    "design-system",
    "component-registry",
    "code-quality",
    "security-scanner",
    "single-source-of-truth",
    "visibility-boundary"
  ],
  "license": "MIT",
  "author": {
    "name": "chaierss",
    "url": "https://www.chaierss.fun"
  },
  "homepage": "https://www.chaierss.fun",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chaierss/keel.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tests/run-tests.mjs",
    "pack": "node tools/package-skill.mjs",
    "pack:list": "node tools/package-skill.mjs --list",
    "install:local": "node tools/install-local.mjs --target workbuddy"
  }
}
